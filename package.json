{
  "name": "@quack/monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "dev": "vp run --filter './apps/*' --parallel dev",
    "dev:web": "vp run --filter @quack/web dev",
    "dev:server": "vp run --filter @quack/server dev",
    "dev:emails": "vp run --filter @quack/emails dev",
    "build": "vp run --filter './apps/*' --cache build",
    "typecheck": "vp run -r --cache typecheck",
    "typecheck:ci": "vp run -r --cache typecheck:ci",
    "db:rollback": "pnpm --filter @quack/server db:rollback",
    "db:seed": "pnpm --filter @quack/server db:seed",
    "test": "vp run -r --cache test",
    "check": "vp check",
    "lint": "vp lint --report-unused-disable-directives",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "fallow": "fallow --fail-on-issues",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist apps/*/.output apps/*/.tanstack"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@quack/oxlint-plugin": "workspace:*",
    "@types/node": "catalog:",
    "fallow": "3.49.0",
    "portless": "0.18.1",
    "tsrs": "catalog:",
    "typescript": "catalog:",
    "ultracite": "8.3.1",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.23.0"
}
