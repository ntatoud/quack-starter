{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Exported types are part of a contract even before they have consumers.
  "rules": { "types": "off", "nsTypes": "off" },
  "ignoreDependencies": [
    // `effect-tsgo tsrs` runs the installed tsrs version; knip does not trace that.
    "tsrs",
    // Named by the tsconfig plugin entry that @effect/tsgo reads. The package itself is not needed.
    "@effect/language-service",
  ],
}
