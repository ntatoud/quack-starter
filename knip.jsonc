{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Exported types are part of a contract even before they have consumers.
  "rules": { "types": "off", "nsTypes": "off" },
  "ignoreDependencies": [
    // Named by the tsconfig plugin entry that @effect/tsgo reads. The package itself is not needed.
    "@effect/language-service",
  ],
  "workspaces": {
    "apps/server": {
      // Run through with-dev-database.ts and portless, which knip does not read as entries.
      // The Migrator loads the migrations from their folder, not through an import.
      "entry": [
        "src/database/rollback-main.ts",
        "src/database/seed-main.ts",
        "src/dev/with-public-url.ts",
        "src/database/migrations/*.ts",
      ],
    },
    "apps/web": {
      "entry": ["src/routes/**/*.tsx"],
    },
    "packages/brand": {
      // The JSX of the Logo needs the types of React, which no file imports by name.
      "ignoreDependencies": ["@types/react"],
    },
    "packages/ui": {
      // The components are a library: every export is available to the apps.
      "entry": ["src/components/**/*.tsx", "src/lib/**/*.ts", "src/hooks/*.ts"],
    },
  },
}
