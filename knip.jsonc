{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Exported types are part of a contract even before they have consumers.
  "rules": { "types": "off", "nsTypes": "off" },
  "ignoreDependencies": [
    // Named by the tsconfig plugin entry that @effect/tsgo reads. The package itself is not needed.
    "@effect/language-service",
  ],
  "workspaces": {
    "apps/server": {
      // Run through with-dev-database.ts, which knip does not read as an entry.
      "entry": ["src/database/rollback-main.ts"],
    },
    "apps/web": {
      "entry": ["src/routes/**/*.tsx"],
    },
    "packages/ui": {
      // shadcn components are a library: every export is available to the apps.
      "entry": ["src/components/*.tsx", "src/lib/*.ts"],
    },
  },
}
