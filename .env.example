# Server
# 3001 when unset. `pnpm dev` runs it under portless, which sets PORT to a free port: see the README.
# PORT=3001
# Whether the session cookie is Secure, so sent over https only. True when unset: leave it so in production.
# False here, so the cookie also works in dev on an http origin that is not localhost (a LAN address, a phone).
COOKIE_SECURE=false
# What the API allows before it answers 429 TooManyAttempts, until the window ends. These are the values when unset.
# Sign-ins that failed on one email, and from one address whatever the email. Sign-ups from one address.
# SIGN_IN_FAILURES_PER_EMAIL=5
# SIGN_IN_FAILURES_PER_EMAIL_WINDOW=15 minutes
# SIGN_IN_FAILURES_PER_IP=20
# SIGN_IN_FAILURES_PER_IP_WINDOW=15 minutes
# SIGN_UPS_PER_IP=10
# SIGN_UPS_PER_IP_WINDOW=1 hour
# Password Resets asked for one email, whether a User has it or not, and from one address whatever the email.
# PASSWORD_RESETS_PER_EMAIL=5
# PASSWORD_RESETS_PER_EMAIL_WINDOW=1 hour
# PASSWORD_RESETS_PER_IP=20
# PASSWORD_RESETS_PER_IP_WINDOW=1 hour
# Fetches of AI Clients' documents one User makes Quack do on the consent page, those served from the cache aside.
# Failed token requests (a wrong code or refresh token) from one address; one that succeeds is not counted.
# CLIENT_DOCUMENT_FETCHES_PER_USER=30
# CLIENT_DOCUMENT_FETCHES_PER_USER_WINDOW=15 minutes
# TOKEN_FAILURES_PER_IP=20
# TOKEN_FAILURES_PER_IP_WINDOW=15 minutes
# The web app's origin, the one address AI Clients reach Quack at: the OAuth issuer and the MCP resource are named
# from it. Required: the server does not start without it. Under portless, `pnpm dev` sets it to the web app's URL.
PUBLIC_URL=http://localhost:3000
# Whether an AI Client may serve its document over http from this machine (localhost, 127.0.0.1), as a local
# MCP Inspector does. False when unset: leave it so in production, where loopback addresses are never fetched.
AI_CLIENT_LOOPBACK_HTTP=true
# Whether an AI Client that comes back for what its active Grant already holds skips the consent page. False when
# unset: the User approves every authorization request.
# OAUTH_REMEMBER_CONSENT=false
# Where the server finds Postgres. Required in production: the server does not start without it.
# SSL goes in the URL (`?sslmode=require`). Derived in dev: `pnpm dev` starts the container of `compose.yaml`,
# creates the database `quack`, and points the server at it. Set it here to use another database instead.
# DATABASE_URL=postgres://quack:quack@127.0.0.1:54320/quack
# Set to `own` to give this checkout a database of its own, `quack_<branch>`, created empty, instead of the shared
# `quack`. A branch with migrations the default branch lacks gets its own whatever this says. Read by `pnpm dev` only.
# DEV_DATABASE=own
# The most connections the server's pool opens at once. 10 when unset.
# DATABASE_MAX_CONNECTIONS=10
# How the server sends mail, and who from. Required in production: the server does not start without them.
# Credentials and TLS go in the URL (`smtps://user:password@smtp.example.com:465`). In dev, `pnpm dev` sends to the
# Mailpit of `compose.yaml` (inbox at https://mailpit.quack.localhost), from Quack, unless set here.
# SMTP_URL=smtp://127.0.0.1:10250
# MAIL_FROM="Quack <no-reply@quack.dev>"

# Web
# Where the web server relays /api to. The browser never calls it: it has no VITE_ prefix.
# Read with `PORTLESS=0 pnpm dev` only: under portless, the web app asks portless for the API's URL.
API_URL=http://localhost:3001
