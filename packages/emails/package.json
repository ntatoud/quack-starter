{
  "name": "@quack/emails",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    "./*": "./src/*.tsx"
  },
  "scripts": {
    "dev": "portless run --name emails.quack sh -c 'email dev --dir src/templates --port ${PORT:-3002}'",
    "typecheck": "effect-tsgo tsc --noEmit",
    "typecheck:ci": "effect-tsgo tsrs --noEmit",
    "test": "vp test run"
  },
  "dependencies": {
    "@quack/brand": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-email": "6.11.16"
  },
  "devDependencies": {
    "@react-email/ui": "6.11.16",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "vite-plus": "catalog:"
  }
}
