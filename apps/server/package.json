{
  "name": "@quack/server",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "SEED_USERS=true node --env-file-if-exists=../../.env src/dev/with-dev-database.ts portless run --name api.quack node --watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node --env-file-if-exists=../../.env src/main.ts",
    "typecheck": "effect-tsgo tsc --noEmit",
    "typecheck:ci": "effect-tsgo tsrs --noEmit",
    "db:rollback": "node --env-file-if-exists=../../.env src/dev/with-dev-database.ts node --env-file-if-exists=../../.env src/database/rollback-main.ts",
    "test": "vp test run"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@faker-js/faker": "10.6.0",
    "@quack/contracts": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "vite-plus": "catalog:"
  }
}
