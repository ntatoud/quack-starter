{
  "name": "@quack/server",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env src/dev/with-dev-database.ts --seed portless run --name api.quack node src/dev/with-public-url.ts node --env-file-if-exists=../../.env src/dev/with-dev-mail.ts node --watch --env-file-if-exists=../../.env --import @quack/emails/register src/main.ts",
    "start": "node --env-file-if-exists=../../.env --import @quack/emails/register src/main.ts",
    "typecheck": "effect-tsgo tsc --noEmit",
    "typecheck:ci": "effect-tsgo tsrs --noEmit",
    "db:rollback": "node --env-file-if-exists=../../.env src/dev/with-dev-database.ts node --env-file-if-exists=../../.env src/database/rollback-main.ts",
    "db:seed": "node --env-file-if-exists=../../.env src/dev/with-dev-database.ts node --env-file-if-exists=../../.env src/database/seed-main.ts",
    "test": "vp test run",
    "db:gen": "node --env-file-if-exists=../../.env src/dev/with-dev-database.ts node --env-file-if-exists=../../.env src/database/db-gen-main.ts"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@faker-js/faker": "10.6.0",
    "@quack/brand": "workspace:*",
    "@quack/contracts": "workspace:*",
    "@quack/effect-kysely": "workspace:*",
    "@quack/emails": "workspace:*",
    "effect": "catalog:",
    "kysely": "catalog:",
    "nodemailer": "10.6.1",
    "xstate": "6.0.0-beta.5"
  },
  "devDependencies": {
    "@effect/sql-pglite": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "kysely-codegen": "0.20.0",
    "pg": "8.23.1",
    "vite-plus": "catalog:"
  }
}
